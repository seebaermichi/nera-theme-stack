//- One post (§S4.1, Revision R4): the header (series line, title, lead,
//- author line with published and updated), the post-media seam when the
//- post has an `image`, its `facts`, the body, then the post-tags seam, the
//- parts of its series and the post-pagination seam.
extends ../layouts/layout.pug

block main
    article.post
        header.post__header
            if meta.series && themeStack.seriesParts(meta.series, pageLang({ meta })).length
                p.post__series
                    | #{t('Series')}: #{meta.series}
                    if meta.series_part !== undefined && meta.series_part !== null && meta.series_part !== ''
                        | #{' · '}#{t('Part')} #{meta.series_part}
            h1.post__title= meta.title || app.name
            if meta.lead
                p.post__lead= meta.lead
            p.post__meta
                if meta.author || themeStack.author(pageLang({ meta })).name
                    span.post-author
                        span.post-author__mark(aria-hidden='true')= themeStack.initials(meta.author || themeStack.author(pageLang({ meta })).name)
                        span.post__author.post-author__name= meta.author || themeStack.author(pageLang({ meta })).name
                if isoDate(meta.createdAt)
                    span
                        | #{t('Published')}#{' '}
                        time.post__date(datetime=isoDate(meta.createdAt))= formatDate(meta.createdAt, pageLang({ meta }))
                if isoDate(meta.updated)
                    span
                        | #{t('Updated')}#{' '}
                        time.post__updated(datetime=isoDate(meta.updated))= formatDate(meta.updated, pageLang({ meta }))
        if meta.image
            .post__media
                include ../partials/post-media.pug
        if themeStack.facts({ meta }).length
            dl.post-facts
                each fact in themeStack.facts({ meta })
                    .post-facts__item
                        dt.post-facts__label= fact.label
                        dd.post-facts__value= fact.value
        .post__body.nera-code-scope
            != content
        footer.post__footer
            .post__tags
                include ../partials/post-tags.pug
            if meta.series && themeStack.seriesParts(meta.series, pageLang({ meta })).length
                nav.post-series(aria-label=t('Series'))
                    h2.post-series__title= meta.series
                    ol.post-series__list
                        each part, index in themeStack.seriesParts(meta.series, pageLang({ meta }))
                            if part.meta.href === meta.href
                                li.post-series__item.post-series__item--current
                                    span= String(index + 1).padStart(2, '0')
                                    a(href=part.meta.href aria-current='page')= part.meta.title
                            else
                                li.post-series__item
                                    span= String(index + 1).padStart(2, '0')
                                    a(href=part.meta.href)= part.meta.title
            .post__pagination
                include ../partials/post-pagination.pug
